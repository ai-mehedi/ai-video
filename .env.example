# Copy this file to ".env" and fill in your real values.
# The real .env is gitignored — it is NEVER committed or shared.
#
#   cp .env.example .env
#   nano .env        # paste your key, save
#
# Used by the ChatGPT keyframe step (keyframes.py).
OPENAI_API_KEY=sk-your-key-here

# Optional: which OpenAI image model to use for cartoon keyframes.
OPENAI_IMAGE_MODEL=gpt-image-1
